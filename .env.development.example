# npm run setup:dev copies this to the ignored .env.development.local file.
# Use a Google OAuth Web application client with this authorized redirect URI:
# http://localhost:3100/api/auth/callback/google
# Never paste the client secret in chat or commit it to Git.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Separate Google Contacts data connection client, with callback:
# http://localhost:3100/api/connections/google/callback
GOOGLE_CONNECTOR_CLIENT_ID=
GOOGLE_CONNECTOR_CLIENT_SECRET=
# Separate Calendar data client, distinct from sign-in and Contacts; same callback.
# Use a separate Google Cloud project for independent provider revocation.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Separate app-created-calendar publishing client; same connector callback.
GOOGLE_CALENDAR_PUBLISH_CLIENT_ID=
GOOGLE_CALENDAR_PUBLISH_CLIENT_SECRET=
# Separate Gmail metadata client, distinct from every client above; same callback.
GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=
# Local-only versioned encryption key; never reuse it in staging or production.
CONNECTOR_TOKEN_KEYRING='__GENERATE_CONNECTOR_KEYRING__'
# setup:dev generates an independent random secret for this computer.
BETTER_AUTH_SECRET=__GENERATE_LOCAL_SECRET__

AUTH_MODE=google
NEXT_PUBLIC_AUTH_MODE=google
BETTER_AUTH_URL=http://localhost:3100
SEED_DEMO_DATA=false
