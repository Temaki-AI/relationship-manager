{
  "manifest_version": 3,
  "name": "Bonds LinkedIn Importer",
  "version": "0.1.0",
  "description": "Import LinkedIn profiles into the Bonds personal CRM.",
  "key": "",
  "action": {
    "default_title": "Import LinkedIn profile into Bonds",
    "default_popup": "popup.html"
  },
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "http://localhost:3100/*",
    "http://127.0.0.1:3100/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
