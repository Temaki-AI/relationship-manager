{
  "expo": {
    "name": "Everclose",
    "slug": "bonds-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bonds",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.fernandoamaral.bonds",
      "buildNumber": "9",
      "supportsTablet": true
    },
    "android": {
      "package": "com.fernandoamaral.bonds",
      "adaptiveIcon": {
        "backgroundColor": "#FFF8F4",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF8F4",
          "image": "./assets/images/icon.png",
          "imageWidth": 148
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Everclose lets you choose a person to add to your private relationship journal."
        }
      ],
      "expo-notifications",
      "expo-sqlite",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Allow Everclose to unlock your private relationship journal."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Everclose to unlock your private relationship journal."
        }
      ],
      "expo-web-browser",
      [
        "expo-calendar",
        {
          "calendarPermission": "Everclose can verify the Calendar events you choose and, when enabled, keep their dates updated. On iOS 16, access is also needed for the system event editor.",
          "remindersPermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Everclose saves a small copy of the contact photo you choose.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "onDemandFilesystem": false
    }
  }
}
