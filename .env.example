# Development is open when all CRM auth values are empty.
# Production fails closed unless password and session secret meet the minimum lengths.
CRM_PASSWORD=
CRM_SESSION_SECRET=
# Whole hours from 1-168. Defaults to seven days.
CRM_SESSION_TTL_HOURS=168

# Optional bearer token for the Chrome extension and other API integrations.
CRM_API_TOKEN=

# Optional database and recovery locations, relative to the app directory unless absolute.
# Use dedicated subdirectories owned by the app user; shared/root paths are rejected.
# Bonds enforces 0700 directories and 0600 files.
CRM_DATABASE_PATH=data/relationships.db
CRM_BACKUP_DIRECTORY=data/backups

# Keep 1-100 verified backups, preserving the newest checkpoint for each recovery reason.
CRM_BACKUP_RETENTION_COUNT=20
# Production defaults to a verified backup every 24 hours. Set 0 to disable.
CRM_AUTOMATIC_BACKUP_INTERVAL_HOURS=24
CRM_MAX_RESTORE_MB=256
CRM_MAX_CONTACT_IMPORT_MB=10

# Comma-separated extension IDs and additional cross-origin web clients.
# The app's own browser origin is recognized automatically.
CORS_ALLOWED_EXTENSION_IDS=
CORS_ALLOWED_ORIGINS=

# Only enable when Bonds cannot be reached except through a proxy that overwrites forwarded headers.
# Trusted HTTPS forwarding also controls Secure session cookies and HSTS.
CRM_TRUST_PROXY_HEADERS=false

# Structured privacy-safe server logs: info, warn, error, or silent.
CRM_LOG_LEVEL=info

# Development seeds once by default; production starts empty unless explicitly enabled.
SEED_DEMO_DATA=false

# Cloud deployments use Google OAuth and D1-backed sessions. Keep this unset for local/Docker mode.
AUTH_MODE=
BETTER_AUTH_URL=http://localhost:3100
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_AUTH_MODE=
