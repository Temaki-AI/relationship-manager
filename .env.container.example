# Copy this file to .env before using Docker Compose. Required values are blank
# so Compose fails closed until unique credentials have been provided.
BONDS_PORT=3100
CRM_PASSWORD=
CRM_SESSION_SECRET=
CRM_SESSION_TTL_HOURS=168

# Optional token for the bundled browser extension. Use at least 32 random characters.
CRM_API_TOKEN=
CORS_ALLOWED_EXTENSION_IDS=
CORS_ALLOWED_ORIGINS=
CRM_TRUST_PROXY_HEADERS=false
CRM_LOG_LEVEL=info

CRM_BACKUP_RETENTION_COUNT=20
CRM_AUTOMATIC_BACKUP_INTERVAL_HOURS=24
CRM_MAX_RESTORE_MB=256
CRM_MAX_CONTACT_IMPORT_MB=10
